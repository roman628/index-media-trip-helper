/* Media Trip Helper · component styles.
   Every color and border width is a theme variable (var(--...)); no color is hardcoded here.
   The theme variables live in Resources/Themes/<Name>-<Light|Dark>.uss (one file per variant).
   Sizes are points. The root carries .k-phone / .k-port / .k-land (and .xwide) so rules can
   follow the layout the screens were built for. */

.theme {
    background-color: var(--bg);
    color: var(--tx);
    font-size: 17px;
    width: 100%;
    height: 100%;
}
.theme.k-phone { font-size: 16px; }

/* ---------- layout primitives ---------- */
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.stretch { align-items: stretch; }
.top-align { align-items: flex-start; }
.center { justify-content: center; }
.fullsize { width: 100%; height: 100%; }
.minh0 { min-height: 0; }
.noshrink { flex-shrink: 0; }
.hidden { display: none; }
.scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.scroll > * > .unity-scroll-view__content-viewport { flex-grow: 1; }
.scrollx { flex-grow: 0; flex-shrink: 0; }
.scrollx .unity-scroll-view__content-container { flex-direction: row; align-items: center; }
.bordered-right { border-right-width: 2px; border-color: var(--bd); }
.bordered-left { border-left-width: 2px; border-color: var(--bd); }
.bordered-top { border-top-width: 2px; border-color: var(--bd); }
.bordered-bottom { border-bottom-width: 1px; border-color: var(--sf2); }

/* ---------- text ---------- */
Label { color: var(--tx); white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; }
.h1 { font-size: 26px; -unity-font-style: bold; }
.h2 { font-size: 21px; -unity-font-style: bold; }
.h3 { font-size: 18px; -unity-font-style: bold; }
.k-phone .h1 { font-size: 23px; }
.k-phone .h2 { font-size: 19px; }
.body { font-size: 17px; }
.body-sm { font-size: 16px; }
.bold { -unity-font-style: bold; }
.sub { color: var(--tx2); font-size: 14px; }
.muted { color: var(--tx2); }
.accent { color: var(--ac); }
.bad-text { color: var(--bad); }
.ok-text { color: var(--ok); }
.eyebrow { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: var(--tx2); }
.lbl { font-size: 12px; -unity-font-style: bold; color: var(--tx2); letter-spacing: 0.8px; margin-bottom: 6px; }
.strike { color: var(--tx2); }
.mono { font-size: 14px; }
.nowrap { white-space: nowrap; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---------- buttons ---------- */
.btn {
    height: 50px; padding: 0 18px; margin: 0;
    border-radius: 12px; border-width: var(--bw); border-color: var(--bd);
    background-color: var(--sf); color: var(--tx);
    font-size: 17px; -unity-font-style: bold;
    flex-direction: row; align-items: center; justify-content: center;
    white-space: nowrap; -unity-text-align: middle-center; flex-shrink: 0;
}
.btn:hover { background-color: var(--sf2); }
.btn:active { background-color: var(--bd); }
.btn:focus { border-color: var(--ac); }
.btn:disabled { opacity: 0.35; }
.btn.pri { background-color: var(--ac); color: var(--acTx); border-color: var(--ac); }
.btn.pri Label { color: var(--acTx); }
.btn.pri .glyph { color: var(--acTx); }
.btn.pri:hover { opacity: 0.88; }
.btn.big { height: 60px; font-size: 19px; padding: 0 24px; }
.btn.big Label { font-size: 19px; }
.btn.sm { height: 44px; font-size: 15px; padding: 0 14px; }
.btn.ic { width: 50px; padding: 0; }
.btn.ic.sm { width: 44px; }
.btn.ghost { border-color: rgba(0,0,0,0); background-color: rgba(0,0,0,0); }
.btn.ghost:hover { background-color: var(--sf2); }
.btn.add { color: var(--ac); justify-content: flex-start; align-self: flex-start; }
.btn.accent { color: var(--ac); }
.btn.danger { color: var(--bad); }
.btn.danger Label { color: var(--bad); }
.btn.left { justify-content: flex-start; -unity-text-align: middle-left; }
.btn.left Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.plain { background-color: rgba(0,0,0,0); border-width: 0; padding: 0; margin: 0; color: var(--tx); border-radius: 0; }

/* ---------- inputs ---------- */
.inp { height: 52px; margin: 0; flex-shrink: 0; }
.inp > .unity-text-field__input, .inp .unity-base-text-field__input {
    border-width: var(--bw); border-color: var(--bd); border-radius: 10px;
    padding: 0 14px; font-size: 17px; background-color: var(--sf); color: var(--tx);
    -unity-text-align: middle-left;
}
.inp:focus > .unity-text-field__input, .inp .unity-base-text-field__input:focus { border-color: var(--ac); }
.inp.err > .unity-text-field__input { border-color: var(--bad); }
.inp.tall { height: 56px; }
.inp.tall > .unity-text-field__input { font-size: 19px; -unity-font-style: bold; }
.inp.multi { height: 88px; }
.inp.multi > .unity-text-field__input { padding: 12px 14px; -unity-text-align: upper-left; white-space: normal; }
.inp.h44 { height: 44px; }
.inp.h48 { height: 48px; }
.inp.h72 { height: 72px; }
.inp.h96 { height: 96px; }
.inp .unity-text-element--placeholder, .inp .unity-text-field__input .unity-text-element { color: var(--tx); }
.fld { flex-direction: column; margin-bottom: 14px; }

/* ---------- status ring ---------- */
.st {
    align-items: center; justify-content: center; border-radius: 50%;
    border-width: 3px; border-color: var(--bd); color: var(--tx2);
    background-color: var(--sf); flex-shrink: 0; padding: 0; margin: 0;
}
.st-captured { background-color: var(--ok); border-color: var(--ok); color: var(--okTx); }
.st-partial { border-color: var(--warn); color: var(--warn); }
.st-dropped { border-color: var(--bad); color: var(--bad); }
.st-superseded { border-color: var(--tx2); color: var(--tx2); background-color: var(--sf2); }
.st-hero-missing { border-color: var(--bad); color: var(--bad); }
.st-suggest { border-color: var(--ac); color: var(--ac); }

/* ---------- pills / chips / toggles ---------- */
.pill {
    flex-direction: row; align-items: center; height: 28px; padding: 0 10px; margin: 0;
    border-radius: 14px; border-width: 2px; border-color: var(--bd); color: var(--tx2);
    background-color: rgba(0,0,0,0); flex-shrink: 0;
}
.pill Label { white-space: nowrap; color: var(--tx2); font-size: 13px; -unity-font-style: bold; }
.pill.md { height: 36px; padding: 0 12px; margin: 0 6px 6px 0; }
.pill.md Label { font-size: 14px; }
.pill.ok { border-color: var(--ok); color: var(--ok); } .pill.ok Label { color: var(--ok); }
.pill.warn { border-color: var(--warn); color: var(--warn); } .pill.warn Label { color: var(--warn); }
.pill.bad { border-color: var(--bad); color: var(--bad); } .pill.bad Label { color: var(--bad); }
.pill.ac { border-color: var(--ac); color: var(--ac); } .pill.ac Label { color: var(--ac); }
.pill.fill { background-color: var(--ok); color: var(--okTx); border-color: var(--ok); } .pill.fill Label { color: var(--okTx); }
.pill.fillbad { background-color: var(--bad); color: var(--badTx); border-color: var(--bad); } .pill.fillbad Label { color: var(--badTx); }
.pill.label { min-width: 92px; justify-content: center; margin-right: 12px; }

.chip {
    height: 44px; padding: 0 14px; margin: 0 8px 8px 0; border-radius: 22px;
    border-width: var(--bw); border-color: var(--bd); background-color: var(--sf); color: var(--tx);
    font-size: 15px; -unity-font-style: bold; flex-direction: row; align-items: center; white-space: nowrap; flex-shrink: 0;
}
.chip Label { white-space: nowrap; font-size: 15px; -unity-font-style: bold; }
.chip:hover { background-color: var(--sf2); }
.chip.on { background-color: var(--tx); color: var(--bg); border-color: var(--tx); }
.chip.on Label { color: var(--bg); }
.chip.on .glyph { color: var(--bg); }
.chip.ok { border-color: var(--ok); color: var(--ok); }
.chip.ok Label { color: var(--ok); }
.chip.ok .glyph { color: var(--ok); }
.chip.ok.on { background-color: var(--ok); color: var(--okTx); }
.chip.ok.on Label { color: var(--okTx); }
.chip.ok.on .glyph { color: var(--okTx); }
.chip.dashed { background-color: rgba(0,0,0,0); color: var(--tx2); }
.chip.static { height: 40px; }
.chip.wrapok { height: auto; min-height: 44px; padding-top: 6px; padding-bottom: 6px; white-space: normal; flex-shrink: 1; max-width: 100%; }
.chip.wrapok Label { white-space: normal; flex-shrink: 1; }

.tog {
    flex-direction: row; align-items: center; height: 44px; padding: 0 6px 0 14px; margin: 0;
    border-radius: 22px; border-width: var(--bw); border-color: var(--bd); background-color: var(--sf);
    color: var(--tx); flex-shrink: 0;
}
.tog Label { white-space: nowrap; font-size: 15px; -unity-font-style: bold; }
.tog:hover { background-color: var(--sf2); }
.tog .knob { width: 44px; height: 28px; border-radius: 14px; background-color: var(--bd); margin-left: 10px; flex-direction: row; align-items: center; padding: 0 3px; }
.tog .knob .dot { width: 22px; height: 22px; border-radius: 11px; background-color: var(--sf); }
.tog.on .knob { background-color: var(--ac); justify-content: flex-end; }

.check {
    width: 48px; height: 48px; border-radius: 10px; border-width: 3px; border-color: var(--bd);
    align-items: center; justify-content: center; color: var(--tx2); flex-shrink: 0;
    background-color: var(--sf); padding: 0; margin: 0;
}
.check:hover { background-color: var(--sf2); }
.check.on { background-color: var(--ok); border-color: var(--ok); color: var(--okTx); }
.check.sm { width: 44px; height: 44px; }

.num {
    align-items: center; justify-content: center; min-width: 44px; height: 34px; padding: 0 8px; margin: 0 12px 0 0;
    border-radius: 8px; background-color: var(--sf2); color: var(--tx); -unity-font-style: bold; font-size: 15px;
    flex-shrink: 0; -unity-text-align: middle-center; white-space: nowrap;
}
.num.md { height: 40px; font-size: 17px; }
.num.sm { height: 32px; }

.card { background-color: var(--sf); border-width: var(--bw); border-color: var(--bd); border-radius: 16px; padding: 16px; }
.card.ac { border-color: var(--ac); }
.hr { height: 2px; background-color: var(--bd); width: 100%; flex-shrink: 0; }
.stepper { flex-direction: row; align-items: center; border-width: var(--bw); border-color: var(--bd); border-radius: 10px; height: 52px; width: 180px; background-color: var(--sf); }
.stepper .stepbtn { width: 56px; height: 100%; color: var(--ac); align-items: center; justify-content: center; background-color: rgba(0,0,0,0); border-width: 0; margin: 0; padding: 0; }
.stepper .stepbtn:hover { background-color: var(--sf2); }
.stepper .val { flex-grow: 1; -unity-text-align: middle-center; font-size: 20px; -unity-font-style: bold; }

.segc { flex-direction: row; border-width: var(--bw); border-color: var(--bd); border-radius: 12px; overflow: hidden; height: 48px; background-color: var(--sf); flex-shrink: 0; }
.segc .segb { padding: 0 10px; margin: 0; font-size: 15px; -unity-font-style: bold; color: var(--tx); flex-direction: row; align-items: center; justify-content: center; border-width: 0; border-right-width: 2px; border-color: var(--bd); border-radius: 0; background-color: rgba(0,0,0,0); flex-basis: 0; white-space: nowrap; }
.segc .segb.last { border-right-width: 0; }
.segc .segb:hover { background-color: var(--sf2); }
.segc .segb.on { background-color: var(--tx); color: var(--bg); }

/* ---------- list rows ---------- */
.item {
    flex-direction: row; align-items: center; min-height: 60px; padding: 8px 12px; margin: 0;
    border-radius: 12px; border-width: var(--bw); border-color: rgba(0,0,0,0); width: 100%; color: var(--tx);
    background-color: rgba(0,0,0,0);
}
.item:hover { background-color: var(--sf2); }
.item:active { background-color: var(--bd); }
.item.on { background-color: var(--sf); border-color: var(--ac); }
.item.outlined { border-color: var(--bd); }
.item.h48 { min-height: 48px; }
.item.h52 { min-height: 52px; }
.item .title { font-size: 17px; -unity-font-style: bold; }
.note { flex-direction: row; align-items: flex-start; margin-bottom: 5px; }
.note .lb { min-width: 26px; color: var(--tx2); -unity-font-style: bold; flex-shrink: 0; }
.note .txt { white-space: normal; flex-shrink: 1; flex-grow: 1; }

/* ---------- overlay / sheet / toast / suggestions ---------- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center; }
.overlay.top { justify-content: flex-start; }
.overlay.clear { background-color: rgba(0,0,0,0); align-items: flex-end; justify-content: flex-start; }
.sheet { background-color: var(--bg); border-width: var(--bw); border-color: var(--bd); border-radius: 20px; flex-direction: column; padding: 20px; max-width: 100%; max-height: 100%; }
.sheet.full { width: 100%; height: 100%; border-radius: 0; border-width: 0; padding: 16px; }
.menu { width: 240px; padding: 6px; margin: 64px 10px 0 0; }
.toast { position: absolute; bottom: 90px; background-color: var(--tx); color: var(--bg); padding: 12px 20px; border-radius: 12px; font-size: 16px; -unity-font-style: bold; align-self: center; white-space: normal; }
.sugg { background-color: var(--sf); border-width: var(--bw); border-color: var(--ac); border-radius: 12px; overflow: hidden; }
.sugg-row { flex-direction: row; align-items: center; width: 100%; min-height: 56px; padding: 8px 14px; margin: 0; border-width: 0; border-bottom-width: 1px; border-color: var(--bd); color: var(--tx); background-color: rgba(0,0,0,0); border-radius: 0; }
.sugg-row:hover { background-color: var(--sf2); }

/* ---------- chrome: rail, bottom bar, header ---------- */
.rail { width: 96px; background-color: var(--chrome); flex-direction: column; align-items: stretch; padding: 12px 8px; flex-shrink: 0; }
.tabbar { background-color: var(--chrome); flex-direction: row; align-items: stretch; flex-shrink: 0; padding: 6px 6px 8px 6px; }
.k-phone .tabbar { padding-bottom: 14px; }
.ti { flex-direction: column; align-items: center; justify-content: center; border-radius: 12px; margin: 0; padding: 0; border-width: 0; background-color: rgba(0,0,0,0); color: var(--chromeTx); opacity: 0.72; }
.ti Label { color: var(--chromeTx); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; margin-top: 2px; }
.ti:hover { opacity: 1; }
.ti.on { opacity: 1; background-color: var(--ac); color: var(--acTx); }
.ti.on Label { color: var(--acTx); }
.rail .ti { height: 72px; margin-bottom: 4px; }
.rail .ti.ident { height: 64px; margin-bottom: 10px; opacity: 1; }
.rail .ti.ident Label { font-size: 13px; white-space: normal; letter-spacing: 0.5px; }
.tabbar .ti { flex-grow: 1; flex-basis: 0; min-height: 48px; }
.hdr { flex-direction: row; align-items: center; padding: 0 12px 0 16px; border-bottom-width: 2px; border-color: var(--bd); flex-shrink: 0; height: 60px; }
.hdr .t { font-size: 20px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hdr .back { margin: 0 4px 0 -10px; }
.footer { flex-direction: row; align-items: center; padding: 10px 12px 12px 12px; border-top-width: 2px; border-color: var(--bd); flex-shrink: 0; }

/* ---------- trip document ---------- */
.idx { width: 220px; border-right-width: 2px; border-color: var(--bd); flex-direction: column; padding: 12px 8px; flex-shrink: 0; }
.idxb { height: 44px; padding: 0 12px; margin: 0; border-radius: 10px; flex-direction: row; align-items: center; font-size: 15px; -unity-font-style: bold; color: var(--tx2); width: 100%; border-width: var(--bw); border-color: rgba(0,0,0,0); background-color: rgba(0,0,0,0); -unity-text-align: middle-left; }
.idxb:hover { background-color: var(--sf2); }
.idxb.on { background-color: var(--sf); color: var(--tx); border-color: var(--ac); }
.jump { padding: 8px 12px 0 12px; border-bottom-width: 2px; border-color: var(--bd); flex-shrink: 0; }
.jumpb { height: 40px; padding: 0 14px; margin: 0 6px 8px 0; border-radius: 20px; font-size: 14px; -unity-font-style: bold; color: var(--tx2); white-space: nowrap; border-width: var(--bw); border-color: rgba(0,0,0,0); background-color: rgba(0,0,0,0); flex-shrink: 0; }
.jumpb.on { color: var(--tx); border-color: var(--ac); background-color: var(--sf); }
.sec { margin-bottom: 26px; flex-direction: column; }
.kv { flex-direction: row; align-items: flex-start; min-height: 44px; padding: 6px 0; border-bottom-width: 1px; border-color: var(--sf2); }
.kv .k { width: 150px; flex-shrink: 0; color: var(--tx2); font-size: 14px; -unity-font-style: bold; padding-top: 3px; }
.k-phone .kv .k { width: 100px; }
.kv .v { font-size: 17px; flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; }
.docpad > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 18px 28px 60px 28px; }
.k-phone .docpad > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 12px 16px 40px 16px; }
.pad > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 18px 22px 40px 22px; }
.k-phone .pad > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 12px 16px 30px 16px; }
.listpad > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 0 12px 24px 12px; }

/* ---------- shot list ---------- */
.controls { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 10px 12px 2px 12px; flex-shrink: 0; }
.controls .segc { width: 360px; margin-right: 12px; margin-bottom: 8px; }
.k-phone .controls .segc { width: 100%; margin-right: 0; }
.controls .tog { margin-bottom: 8px; }
.chaphead { margin: 14px 0 4px 12px; }
.bookhead { margin: 10px 12px 0 12px; }
.change { flex-direction: row; align-items: flex-start; padding: 12px 0; margin: 0; border-width: 0; border-bottom-width: 2px; border-color: var(--sf2); width: 100%; background-color: rgba(0,0,0,0); border-radius: 0; color: var(--tx); }
.change:hover { background-color: var(--sf2); }
.detail { border-left-width: 2px; border-color: var(--bd); padding: 18px 20px; min-height: 0; flex-shrink: 0; flex-direction: column; }
.planbox { background-color: var(--sf2); border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; flex-direction: column; }
.planbox .k { font-size: 11px; -unity-font-style: bold; letter-spacing: 0.8px; color: var(--ac); margin-bottom: 2px; }
.planbox .v { font-size: 15px; white-space: normal; }
.planstrip > * > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 10px 16px; }
.planstrip { border-bottom-width: 2px; border-color: var(--bd); background-color: var(--sf2); flex-shrink: 0; }

/* ---------- outliner (edit) ---------- */
.orow { flex-direction: row; align-items: center; min-height: 48px; margin-bottom: 4px; }
.orow .olb { min-width: 26px; color: var(--tx2); -unity-font-style: bold; font-size: 14px; -unity-text-align: middle-right; margin-right: 8px; flex-shrink: 0; }
.orow .inp { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 46px; }
.orow .inp > .unity-text-field__input { border-color: rgba(0,0,0,0); border-radius: 8px; padding: 0 10px; font-size: 16px; }
.orow .inp:hover > .unity-text-field__input { border-color: var(--bd); }
.orow .inp:focus > .unity-text-field__input { border-color: var(--ac); }
.ob { width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 8px; color: var(--tx2); flex-shrink: 0; background-color: rgba(0,0,0,0); border-width: 0; padding: 0; margin: 0; }
.ob:hover { background-color: var(--sf2); }

/* ---------- covers ---------- */
.slot { border-width: var(--bw); border-color: var(--bd); border-radius: 16px; background-color: var(--sf); padding: 12px 14px; flex-direction: column; align-items: stretch; color: var(--tx); min-height: 120px; margin: 0 10px 10px 0; flex-shrink: 0; }
.slot:hover { background-color: var(--sf2); }
.slot.empty { border-color: var(--bad); background-color: rgba(0,0,0,0); }
.slot .ln { flex-direction: row; align-items: flex-start; margin-top: 8px; }
.slot .ln .k { width: 70px; flex-shrink: 0; font-size: 11px; -unity-font-style: bold; letter-spacing: 0.8px; color: var(--tx2); padding-top: 3px; }
.slot .ln .v { font-size: 15px; flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; }
.slot .ln .v.planned { color: var(--tx2); }
.slot .ln .v.assigned { -unity-font-style: bold; }

/* ---------- summary ---------- */
.entry { flex-direction: row; align-items: center; min-height: 72px; padding: 8px 10px 8px 4px; border-radius: 14px; background-color: var(--sf); border-width: var(--bw); border-color: var(--bd); margin-bottom: 8px; flex-shrink: 0; }
.entry.photos { background-color: var(--sf2); }
.entry.drag { border-color: var(--ac); opacity: 0.85; }
.entry .hd { width: 44px; height: 56px; align-items: center; justify-content: center; color: var(--tx2); flex-shrink: 0; }
.entry .body { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 56px; flex-direction: column; justify-content: center; align-items: stretch; }

/* ---------- import preview / json inspector ---------- */
.issue { flex-direction: row; align-items: flex-start; min-height: 44px; padding: 6px 0; margin: 0; width: 100%; color: var(--tx); background-color: rgba(0,0,0,0); border-width: 0; }
.dot { width: 14px; height: 14px; border-radius: 7px; background-color: var(--bad); margin: 6px 10px 0 0; flex-shrink: 0; }
.dot.warn { background-color: var(--warn); }
.jl { flex-direction: row; min-height: 22px; padding: 0 10px; }
.jl .ln { width: 44px; color: var(--tx2); -unity-text-align: middle-right; margin-right: 14px; flex-shrink: 0; font-size: 14px; }
.jl .code { font-size: 14px; white-space: nowrap; }
.jl.hl { background-color: var(--sf2); }
.jl.hl .ln { color: var(--bad); -unity-font-style: bold; }
.swcard { width: 236px; margin: 0 12px 12px 0; padding: 14px; border-radius: 14px; border-width: 3px; border-color: var(--bd); background-color: var(--sf); color: var(--tx); flex-direction: column; align-items: flex-start; }
.k-phone .swcard { width: 100%; margin-right: 0; }
.sw { width: 24px; height: 24px; border-radius: 6px; border-width: 1px; border-color: var(--bd); margin: 0 4px 4px 0; }

/* ---------- spacing utilities: last, so they win over a component's own margin ---------- */
.mb4 { margin-bottom: 4px; } .mb6 { margin-bottom: 6px; } .mb8 { margin-bottom: 8px; } .mb10 { margin-bottom: 10px; }
.mb12 { margin-bottom: 12px; } .mb14 { margin-bottom: 14px; } .mb16 { margin-bottom: 16px; } .mb18 { margin-bottom: 18px; }
.mt8 { margin-top: 8px; } .mt12 { margin-top: 12px; } .mt16 { margin-top: 16px; } .mt18 { margin-top: 18px; }
.ml6 { margin-left: 6px; } .ml8 { margin-left: 8px; } .ml10 { margin-left: 10px; } .ml12 { margin-left: 12px; }
.mr8 { margin-right: 8px; } .mr10 { margin-right: 10px; } .mr12 { margin-right: 12px; }
