/* Graphite · Dark · theme variables only. Rebranding = editing these values. */
.theme {
    --bg: #121212;
    --sf: #1c1c1c;
    --sf2: #2a2a2a;
    --bd: #6a6a6a;
    --tx: #f5f5f5;
    --tx2: #bdbdbd;
    --ac: #c3a3ff;
    --acTx: #1a0533;
    --ok: #5fd07a;
    --okTx: #06200f;
    --warn: #f0c04a;
    --bad: #ff7b72;
    --badTx: #1a0505;
    --chrome: #000000;
    --chromeTx: #f5f5f5;
    --bw: 2px;
}
