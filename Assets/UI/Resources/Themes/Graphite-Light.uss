/* Graphite · Light · theme variables only. Rebranding = editing these values. */
.theme {
    --bg: #f0f0f0;
    --sf: #ffffff;
    --sf2: #dedede;
    --bd: #8f8f8f;
    --tx: #101010;
    --tx2: #4a4a4a;
    --ac: #5a2ca0;
    --acTx: #ffffff;
    --ok: #1e7a3c;
    --okTx: #ffffff;
    --warn: #855700;
    --bad: #b3261e;
    --badTx: #ffffff;
    --chrome: #101010;
    --chromeTx: #f5f5f5;
    --bw: 2px;
}
